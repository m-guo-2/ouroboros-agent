# Agent service runtime environment.
# Copy to .env (or export in your shell) and fill in deployment-specific
# values. The CLI flag `--config <path>` is the preferred override path;
# env vars below win over the YAML file when set.

# ==================== HTTP / Logging ====================
AGENT_PORT=1997
AGENT_LOG_DIR=

# ==================== MySQL ====================
# Shared with channel-qiwei: same host/port/user/password, different DB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=moli
MYSQL_PASSWORD=
# Per-service database
AGENT_MYSQL_DATABASE=moli_agent
# Connection pool
AGENT_MYSQL_MAX_OPEN_CONNS=16
AGENT_MYSQL_MAX_IDLE_CONNS=8
AGENT_MYSQL_CONN_MAX_LIFETIME=30m
# Extra DSN params; multiStatements=true is REQUIRED so goose can run
# multi-statement migration files.
AGENT_MYSQL_PARAMS=charset=utf8mb4&collation=utf8mb4_bin&parseTime=true&loc=UTC&multiStatements=true

# DEPRECATED: legacy SQLite path. Setting this only triggers a startup
# warning; data is no longer read from or written to SQLite.
AGENT_DB_PATH=

# ==================== GitHub skills repo ====================
GITHUB_TOKEN=
GITHUB_SKILLS_REPO=
GITHUB_BRANCH=main
GITHUB_SKILLS_PATH=skills
GITHUB_SKILLS_LOCAL_DIR=
GITHUB_SYNC_INTERVAL=15m

# ==================== OSS ====================
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_REGION=
OSS_PREFIX=
OSS_USE_SSL=true

# ==================== Qiwei downstream URL ====================
QIWEI_BASE_URL=http://127.0.0.1:2000
