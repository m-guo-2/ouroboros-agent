#!/usr/bin/env python3
"""查天气。

用法:
  weather --city "北京"
  weather --city "110101" --forecast

参数:
  --city      城市名或 adcode（必填）
  --forecast  加上此参数返回未来 4 天预报，否则返回实况
"""
import os, sys
sys.path.insert(0, os.path.dirname(__file__))
from _amap_client import call_amap, output, parse_args

args = parse_args(sys.argv[1:], required=["city"])

city = args["city"]
if not city.isdigit():
    geo = call_amap("/v3/config/district", {"keywords": city, "subdistrict": "0"})
    districts = geo.get("districts", [])
    if districts:
        city = districts[0].get("adcode", city)

extensions = "all" if "forecast" in args else "base"
result = call_amap("/v3/weather/weatherInfo", {"city": city, "extensions": extensions})
output(result)
