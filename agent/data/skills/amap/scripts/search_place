#!/usr/bin/env python3
"""搜索地点或周边设施。

用法:
  search_place --query "星巴克"
  search_place --query "餐厅" --city "北京"
  search_place --query "加油站" --around "116.397,39.909" --radius 2000

参数:
  --query   搜索关键词（必填）
  --city    城市名，缩小范围
  --around  中心坐标（经度,纬度），启用周边搜索
  --radius  周边搜索半径（米），默认 1000
"""
import os, sys
sys.path.insert(0, os.path.dirname(__file__))
from _amap_client import call_amap, output, parse_args

args = parse_args(sys.argv[1:], required=["query"])

if "around" in args:
    params = {
        "keywords": args["query"],
        "location": args["around"],
        "radius": args.get("radius", "1000"),
    }
    result = call_amap("/v3/place/around", params)
else:
    params = {"keywords": args["query"]}
    if "city" in args:
        params["city"] = args["city"]
    result = call_amap("/v3/place/text", params)

output(result)
