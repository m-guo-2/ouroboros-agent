#!/usr/bin/env python3
"""读取文档内容。

用法:
  read_doc --url "https://docs.qq.com/doc/xxx"
  read_doc --file_id "xxx"

参数（二选一）:
  --url       文档链接
  --file_id   文档 ID

返回: 文档的 Markdown 内容
"""
import os, re, sys
sys.path.insert(0, os.path.dirname(__file__))
from _mcp_client import call_mcp, output, parse_args

args = parse_args(sys.argv[1:])

file_id = args.get("file_id", "")
if not file_id and "url" in args:
    m = re.search(r'docs\.qq\.com/\w+/([A-Za-z0-9_-]+)', args["url"])
    if m:
        file_id = m.group(1)

if not file_id:
    output({"error": "需要 --url 或 --file_id 参数"})
    sys.exit(1)

result = call_mcp("get_content", {"file_id": file_id})
output(result)
