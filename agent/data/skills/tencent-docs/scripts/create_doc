#!/usr/bin/env python3
"""创建在线文档。

用法:
  create_doc --title "标题" --markdown "# 内容..."
  create_doc --title "标题" --markdown "# 内容..." --parent_id "xxx"

参数:
  --title      文档标题（必填）
  --markdown   文档内容，Markdown 或 MDX 格式（必填）
  --parent_id  父节点 ID，不填则在根目录创建

返回: 包含 url 字段的 JSON
"""
import os, sys
sys.path.insert(0, os.path.dirname(__file__))
from _mcp_client import call_mcp, output, parse_args

args = parse_args(sys.argv[1:], required=["title", "markdown"])

params = {"title": args["title"], "mdx": args["markdown"]}
if "parent_id" in args:
    params["parent_id"] = args["parent_id"]

result = call_mcp("create_smartcanvas_by_mdx", params)
output(result)
