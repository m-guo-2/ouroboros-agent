PORT=1997
AGENT_APP_VERSION=prod
AGENT_ID=agent-main
DB_PATH=__DATA_DIR__/config.db
LOG_DIR=__LOG_DIR__
ADMIN_DIST=__INSTALL_PREFIX__/admin/dist

# GitHub-backed skill store settings.
GITHUB_TOKEN=
GITHUB_SKILLS_REPO=
GITHUB_SKILLS_BRANCH=main
GITHUB_SKILLS_PATH=
GITHUB_SYNC_INTERVAL=15m

