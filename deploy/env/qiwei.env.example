# Required Qiwei platform settings.
QIWEI_API_BASE_URL=https://api.qiweapi.com
QIWEI_TOKEN=
QIWEI_GUID=

# Service settings.
QIWEI_BOT_PORT=2000
QIWEI_HTTP_TIMEOUT_SECONDS=25
QIWEI_LOG_LEVEL=info

# Agent routing.
AGENT_ENABLED=true
AGENT_SERVER_URL=http://127.0.0.1:1997
AGENT_ID=agent-prod

# Volcengine speech ASR.
VOLC_SPEECH_APP_KEY=
VOLC_SPEECH_ACCESS_KEY=
VOLC_SPEECH_RESOURCE_ID=volc.seedasr.auc
# Optional; defaults are built into channel-qiwei.
VOLC_SPEECH_SUBMIT_URL=
VOLC_SPEECH_QUERY_URL=
