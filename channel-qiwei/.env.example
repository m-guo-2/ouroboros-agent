# ==================== 企微开放平台配置 ====================

# QiWe API 基础地址
QIWEI_API_BASE_URL=https://api.qiweapi.com

# QiWe 平台令牌（租户 token）
# 仅首启 seed 默认账号时使用；后续以 qiwei_accounts 表为准
QIWEI_TOKEN=your_token_here

# QiWe 设备实例 GUID（同上，仅 seed 用）
QIWEI_GUID=your_guid_here

# ==================== 多账号 / 管理接口 ====================

# 账号元数据 SQLite 路径，留空则使用 {data_dir}/qiwei.db
QIWEI_DB_PATH=

# 管理接口鉴权 Token；留空则 /api/qiwei/_admin/* 返回 404
QIWEI_ADMIN_TOKEN=

# Gateway 查询接口鉴权 Token；留空则 /api/qiwei/gateway/* 返回 404
QIWEI_GATEWAY_TOKEN=

# 账号资料（self_name / self_avatar_url / ...）后台同步周期
QIWEI_PROFILE_SYNC_INTERVAL=6h

# 联系人/群快照后台全量同步周期
QIWEI_CONTACT_SYNC_INTERVAL=6h

# 是否开启联系人/群快照后台全量同步（事件驱动同步始终可用）
QIWEI_CONTACT_SYNC_ENABLED=true

# ==================== 服务配置 ====================

# 服务端口
QIWEI_BOT_PORT=2000

# HTTP 请求超时（秒）
QIWEI_HTTP_TIMEOUT_SECONDS=25

# 日志级别（debug/info/warn/error）
QIWEI_LOG_LEVEL=info

# ==================== Agent 联动 ====================

# 是否开启 Agent 联动（默认 true）
AGENT_ENABLED=true

# Agent Server 地址
AGENT_SERVER_URL=http://localhost:1997

# 当前 bot 对应的 Agent ID（可选）
AGENT_ID=
